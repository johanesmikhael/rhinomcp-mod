<Project Sdk="Microsoft.NET.Sdk">
	
  <PropertyGroup>
    <TargetFrameworks>net7.0</TargetFrameworks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.rhp</TargetExt>
    <NoWarn>NU1701</NoWarn>
    <DeployToRhino Condition="'$(DeployToRhino)' == ''">true</DeployToRhino>
    <KangarooSolverPath Condition="'$(KangarooSolverPath)' == '' and Exists('..\KangarooSolver.dll')">..\KangarooSolver.dll</KangarooSolverPath>
    <KangarooSolverPath Condition="'$(KangarooSolverPath)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">/Applications/Rhino 8.app/Contents/Frameworks/RhCore.framework/Versions/A/Resources/ManagedPlugIns/GrasshopperPlugin.rhp/Components/KangarooSolver.dll</KangarooSolverPath>
    <KangarooSolverPath Condition="'$(KangarooSolverPath)' == '' and Exists('$(ProgramFiles)\Rhino 8\Plug-ins\Grasshopper\Components\KangarooSolver.dll')">$(ProgramFiles)\Rhino 8\Plug-ins\Grasshopper\Components\KangarooSolver.dll</KangarooSolverPath>
  </PropertyGroup>
  
  <PropertyGroup>
    <!-- Specifies information for Assembly and Yak -->
    <Version>0.3.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Title>rhinomcp-mod</Title>
    <AssemblyName>rhinomcp-mod</AssemblyName>
    <RootNamespace>rhinomcp_mod</RootNamespace>
    <Company>Mikhael Johanes</Company>
    <Description>Mod of Rhino integration through the Model Context Protocol with improved geometry and topology understanding</Description>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="RhinoCommon" Version="8.17.25066.7001" ExcludeAssets="runtime" />
    <Reference Include="System.Drawing.Common">
      <HintPath>/Applications/Rhino 8.app/Contents/Frameworks/RhCore.framework/Versions/A/Resources/System.Drawing.Common.dll</HintPath>
    </Reference>
    <Reference Include="KangarooSolver">
      <HintPath>$(KangarooSolverPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateKangarooSolverReference" BeforeTargets="ResolveReferences"
          Condition="'$(KangarooSolverPath)' == '' or !Exists('$(KangarooSolverPath)')">
    <Error Text="KangarooSolver.dll was not found. Install Rhino 8 with Grasshopper or build with -p:KangarooSolverPath=/absolute/path/to/KangarooSolver.dll." />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(DeployToRhino)' == 'true'">
    <Exec Command="cp $(TargetPath) '/Applications/Rhino 8.app/Contents/PlugIns/'" />
  </Target>
  
</Project>
